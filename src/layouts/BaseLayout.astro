---
import { getBrandName, helpDeskTriggerAriaLabel, helpDeskTriggerHref, siteConfig } from '../config/site';
import HelpDeskPopup from '../components/HelpDeskPopup.astro';
import Icon from '../components/Icon.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import { toCanonicalPath, withBase } from '../utils/routing';
import { t, type Lang } from '../i18n/ui';
import { translations } from '../i18n/translations';
import { getEquivalentAlternatePath } from '../i18n/utils';
import { getServiceAreas } from '../config/services';
import '../styles/base.css';
import '../templates/editorial-2026/fonts.css';

const activeTemplate = siteConfig.template;
if (activeTemplate === 'classic-legal') {
	await import('../templates/classic-legal/tokens.css');
	await import('../templates/classic-legal/layout.css');
} else if (activeTemplate === 'modern-minimal') {
	await import('../templates/modern-minimal/tokens.css');
	await import('../templates/modern-minimal/layout.css');
} else {
	await import('../templates/editorial-2026/tokens.css');
	await import('../templates/editorial-2026/layout.css');
}

interface Props {
	title?: string;
	description?: string;
	pathname?: string;
	ogType?: 'website' | 'article';
	lang?: Lang;
	ogImage?: string;
	robots?: string;
	lastModified?: string;
	article?: {
		publishedTime?: string;
		modifiedTime?: string;
		tags?: string[];
	};
}

const {
	title = siteConfig.seo.defaultTitle.tr,
	description = siteConfig.seo.defaultDescription.tr,
	pathname = Astro.url.pathname,
	ogType = 'website',
	lang = 'tr',
	ogImage,
	robots = 'index, follow',
	lastModified,
	article,
} = Astro.props;
const basePath = import.meta.env.BASE_URL || '/';
const pathnameWithoutBase =
	basePath !== '/' && pathname.startsWith(basePath)
		? pathname.slice(basePath.length - 1)
		: pathname;

const canonicalUrl = new URL(toCanonicalPath(pathname), siteConfig.seo.siteUrl).toString();
const xdefaultPath = lang === 'tr' ? pathnameWithoutBase : (getEquivalentAlternatePath(pathnameWithoutBase, 'tr') ?? pathnameWithoutBase);
const xdefaultUrl = new URL(
	toCanonicalPath(basePath !== '/' ? `${basePath}${xdefaultPath}`.replace(/\/+/g, '/') : xdefaultPath),
	siteConfig.seo.siteUrl,
).toString();
const altLang: Lang = lang === 'tr' ? 'en' : 'tr';
const altPathRaw = getEquivalentAlternatePath(pathnameWithoutBase, altLang);
const alternateUrl = altPathRaw
	? new URL(
			toCanonicalPath(basePath !== '/' ? `${basePath}${altPathRaw}`.replace(/\/+/g, '/') : altPathRaw),
			siteConfig.seo.siteUrl,
		).toString()
	: null;

const nav = [
	{ href: lang === 'tr' ? '/' : '/en/', key: 'home' as const },
	{ href: lang === 'tr' ? '/hakkimda' : '/en/about', key: 'about' as const },
	{ href: lang === 'tr' ? '/hizmetler' : '/en/services', key: 'services' as const },
	{ href: lang === 'tr' ? '/iletisim' : '/en/contact', key: 'contact' as const },
	{ href: lang === 'tr' ? '/blog' : '/en/blog', key: 'blog' as const },
];
const servicesBase = lang === 'tr' ? '/hizmetler' : '/en/services';
const localizedServiceAreas = getServiceAreas(lang);
const ogImageRaw = ogImage || siteConfig.seo.ogImage;
const ogImageUrl = ogImageRaw?.startsWith('http') ? ogImageRaw : new URL(withBase(ogImageRaw), siteConfig.seo.siteUrl).toString();
const iconVersion = 'v=2';
const faviconSvg = withBase(`/favicon.svg?${iconVersion}`);
const faviconIco = withBase(`/favicon.ico?${iconVersion}`);
const appleTouchIcon = withBase(`/apple-touch-icon.png?${iconVersion}`);
const htmlLang = lang === 'tr' ? 'tr' : 'en';
const ogLocale = translations[lang].seo.locale;
const rightsText = translations[lang].footer.rights;
const brandName = getBrandName(lang);
const [brandLeadRaw, ...brandRest] = brandName.split(' ');
const brandLead = lang === 'en' ? brandLeadRaw.toUpperCase() : brandLeadRaw;
const brandSub = brandRest.join(' ');

const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID as string | undefined;

const legalServiceSchema = {
	'@context': 'https://schema.org',
	'@type': 'LegalService',
	name: brandName,
	description: siteConfig.seo.defaultDescription[lang],
	url: siteConfig.seo.siteUrl,
	email: siteConfig.contact.email,
	telephone: siteConfig.contact.phoneDisplay,
	address: {
		'@type': 'PostalAddress',
		addressLocality: siteConfig.contact.address,
	},
	areaServed: 'Turkey',
};
---

<!doctype html>
<html lang={htmlLang} data-template={siteConfig.template}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<meta name="google-site-verification" content="AOvvSyYRpFOW1OYLBZAYRZXQbR6KEloq_aQ5mT1DYJk" />
		{lastModified && <meta name="dateModified" content={lastModified} />}
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang={lang === 'tr' ? 'tr' : 'en'} href={canonicalUrl} />
		{alternateUrl && <link rel="alternate" hreflang={altLang} href={alternateUrl} />}
		<link rel="alternate" hreflang="x-default" href={xdefaultUrl} />
		<meta property="og:site_name" content={brandName} />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:image" content={ogImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		{article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
		{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
		{
			article?.tags?.map((tag) => (
				<meta property="article:tag" content={tag} />
			))
		}
		<link rel="icon" type="image/svg+xml" sizes="any" href={faviconSvg} />
		<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={faviconIco} />
		<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon} />
		{
			ga4Id && (
				<>
					<script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
					<script set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4Id}');`} />
				</>
			)
		}
		<script type="application/ld+json" set:html={JSON.stringify(legalServiceSchema)} />
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header">
				<div class="container header-row">
					<a class="brand" href={withBase(lang === 'tr' ? '/' : '/en/')} aria-label={brandName}>
						<span class="brand-name">{brandLead}</span>
						{brandSub && <span class="brand-sub">{brandSub}</span>}
					</a>
					<nav class="nav" aria-label="Primary">
						{
							nav.map((item) =>
								item.key === 'services' ? (
									<div class="nav-dropdown">
										<a href={withBase(item.href)} aria-current={pathnameWithoutBase.startsWith('/hizmetler') || pathnameWithoutBase.startsWith('/en/services') ? 'page' : undefined}>
											{t(lang, `nav.${item.key}`)}
										</a>
										<div class="dropdown-menu">
											{
												localizedServiceAreas.map((area) => (
													<a href={withBase(`${servicesBase}/${area.slug}`)}>{area.title}</a>
												))
											}
										</div>
									</div>
								) : (
									<a href={withBase(item.href)} aria-current={pathnameWithoutBase === item.href ? 'page' : undefined}>
										{t(lang, `nav.${item.key}`)}
									</a>
								),
							)
						}
					</nav>
					<div class="header-tools">
						<LangSwitcher lang={lang} pathname={pathnameWithoutBase} />
						<button
							class="menu-btn"
							type="button"
							data-menu-toggle
							aria-expanded="false"
							aria-controls="mobile-nav"
							aria-label={lang === 'tr' ? 'Menü' : 'Menu'}
						>
							<span></span><span></span><span></span>
						</button>
					</div>
				</div>
			</header>
			<main class="main-content">
				<div class="container">
					<Breadcrumb pathname={pathnameWithoutBase} lang={lang} />
					<slot />
				</div>
			</main>
			<footer class="site-footer">
				<div class="container footer-grid">
					<div class="footer-col footer-brand">
						<p class="footer-heading">{brandName}</p>
						<span class="footer-contact-row"><Icon name="map-pin" size={14} />{siteConfig.contact.address}</span>
						<span class="footer-contact-row"><Icon name="mail" size={14} />{siteConfig.contact.email}</span>
						<a class="btn btn-primary" href={helpDeskTriggerHref} aria-label={helpDeskTriggerAriaLabel}><Icon name="message-circle" size={16} />{t(lang, 'footer.liveSupport')}</a>
						<p class="footer-version">{siteConfig.version}</p>
					</div>
					<div class="footer-col">
						<p class="footer-heading">{t(lang, 'footer.quickLinks')}</p>
						<nav aria-label="Footer">
							{
								nav.map((item) => (
									<a href={withBase(item.href)}>{t(lang, `nav.${item.key}`)}</a>
								))
							}
						</nav>
					</div>
					<div class="footer-col">
						<p class="footer-heading">{t(lang, 'footer.practiceAreas')}</p>
						{
							localizedServiceAreas.map((area) => (
								<a href={withBase(`${servicesBase}/${area.slug}`)}>{area.title}</a>
							))
						}
					</div>
					<div class="footer-col">
						<p class="footer-heading">{t(lang, 'footer.institutions')}</p>
						<a href="https://www.istanbulbarosu.org.tr/" target="_blank" rel="noopener noreferrer"><Icon name="external-link" size={12} />{t(lang, 'footer.barAssociation')}</a>
						<a href="https://www.barobirlik.org.tr/" target="_blank" rel="noopener noreferrer"><Icon name="external-link" size={12} />{t(lang, 'footer.barUnion')}</a>
						<a href="https://www.istanbulbarosu.org.tr/ucrettarifeleri" target="_blank" rel="noopener noreferrer"><Icon name="external-link" size={12} />{t(lang, 'footer.feeTariffs')}</a>
						<a href="https://www.istanbulbarosu.org.tr/kategori/adli-yardim" target="_blank" rel="noopener noreferrer"><Icon name="external-link" size={12} />{t(lang, 'footer.legalAid')}</a>
					</div>
				</div>
				<div class="container footer-bottom">
					<p>&copy; {new Date().getFullYear()} {brandName} — {rightsText}</p>
				</div>
			</footer>
		</div>
		<div class="mobile-nav" id="mobile-nav" data-mobile-nav inert aria-hidden="true">
			<nav aria-label={lang === 'tr' ? 'Mobil menü' : 'Mobile menu'}>
				<ul class="mobile-nav-list">
					{
						nav.map((item, index) => (
							<li>
								<a
									href={withBase(item.href)}
									aria-current={
										item.key === 'services'
											? pathnameWithoutBase.startsWith('/hizmetler') || pathnameWithoutBase.startsWith('/en/services')
												? 'page'
												: undefined
											: pathnameWithoutBase === item.href
												? 'page'
												: undefined
									}
								>
									<span>{t(lang, `nav.${item.key}`)}</span>
									<span class="mobile-nav-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
								</a>
							</li>
						))
					}
					<li class="mobile-nav-lang">
						<LangSwitcher lang={lang} pathname={pathnameWithoutBase} />
					</li>
				</ul>
			</nav>
		</div>
		<script>
			(() => {
				const button = document.querySelector('[data-menu-toggle]');
				const panel = document.getElementById('mobile-nav');
				if (!(button instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) {
					return;
				}

				const setMenu = (open, moveFocus = true) => {
					document.body.classList.toggle('menu-open', open);
					button.setAttribute('aria-expanded', String(open));
					panel.toggleAttribute('inert', !open);
					panel.setAttribute('aria-hidden', String(!open));
					if (!moveFocus) {
						return;
					}
					if (open) {
						const first = panel.querySelector('a');
						if (first instanceof HTMLElement) {
							requestAnimationFrame(() => first.focus());
						}
					} else {
						button.focus();
					}
				};

				button.addEventListener('click', () => {
					setMenu(!document.body.classList.contains('menu-open'));
				});

				panel.addEventListener('click', (event) => {
					if (event.target instanceof Element && event.target.closest('a')) {
						setMenu(false, false);
					}
				});

				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape' && document.body.classList.contains('menu-open')) {
						setMenu(false);
					}
				});

				const desktop = window.matchMedia('(min-width: 720px)');
				desktop.addEventListener('change', (event) => {
					if (event.matches) {
						setMenu(false, false);
					}
				});

				setMenu(false, false);
			})();
		</script>
		<HelpDeskPopup lang={lang} />
		<a
			class="whatsapp-fab"
			href={`https://wa.me/${siteConfig.contact.whatsappNumberE164}?text=${encodeURIComponent(translations[lang].helpDesk.whatsappIntro)}`}
			target="_blank"
			rel="noopener noreferrer"
			aria-label={translations[lang].contact.whatsappButton}
		>
			<Icon name="whatsapp" size={24} />
			<span class="whatsapp-fab-label">WhatsApp</span>
		</a>
	</body>
</html>
