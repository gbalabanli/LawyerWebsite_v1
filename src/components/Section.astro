---
interface Props {
	title?: string;
	lead?: string;
	headingLevel?: 'h1' | 'h2';
}

const { title, lead, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<section class="section">
	{
		(title || lead) && (
			<div class="section-heading">
				{title && <Heading>{title}</Heading>}
				{lead && <p class="section-lead">{lead}</p>}
			</div>
		)
	}
	<slot />
</section>
