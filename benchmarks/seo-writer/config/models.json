{
  "$comment": "Provider endpoints and model roster. apiKey is resolved at runtime: (1) provider.apiKey literal, (2) env var in apiKeyEnv, (3) ~/.config/opencode/opencode.json provider options. Never commit real secrets here; prefer apiKeyEnv.",
  "providers": {
    "9router": {
      "baseURL": "http://127.0.0.1:20128/v1",
      "apiKeyEnv": "NINE_ROUTER_API_KEY",
      "opencodeProvider": "9router"
    },
    "zai": {
      "baseURL": "https://open.bigmodel.cn/api/coding/paas/v4",
      "apiKeyEnv": "ZAI_CODING_API_KEY",
      "opencodeProvider": "zai-coding-plan"
    },
    "gemini": {
      "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "apiKeyEnv": "GEMINI_API_KEY",
      "opencodeProvider": "gemini"
    },
    "deepseek": {
      "baseURL": "https://api.deepseek.com",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "opencodeProvider": "deepseek"
    },
    "opencode": {
      "baseURL": "https://opencode.ai/zen/v1",
      "apiKeyEnv": "OPENCODE_API_KEY",
      "opencodeProvider": "opencode",
      "transport": "opencode-cli"
    }
  },
  "defaults": {
    "temperature": 0.7,
    "maxTokens": 4096,
    "timeoutMs": 60000
  },
